<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>My Messages - Shubham Computer</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0,1" rel="stylesheet" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Poppins', sans-serif; }
        :root { --bg: #0f2027; --bg2: #000000; --card: #ffffff0a; --card-solid: #1e2a32; --text: #ffffff; --sub: #aaaaaa; --accent: #00c3ff; --nav: #0c1a20; --border: rgba(255,255,255,0.08); --danger: #ff4d4d; --success: #2ecc71; --warning: #ffaa44; --info: #00c3ff; }
        body { background: radial-gradient(circle at 10% 20%, var(--bg), var(--bg2)); color: var(--text); min-height: 100vh; padding-bottom: 70px; }
        .header { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; background: var(--nav); border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 100; }
        .menu-btn { font-size: 28px; cursor: pointer; }
        .header-right { display: flex; align-items: center; gap: 15px; }
        .notification-bell { position: relative; cursor: pointer; text-decoration: none; color: var(--text); display: inline-flex; align-items: center; justify-content: center; }
        .notification-bell span.material-symbols-rounded { font-size: 28px; }
        .badge-notification { position: absolute; top: -6px; right: -8px; background: #e53935; color: white; font-size: 11px; font-weight: 700; width: 20px; height: 20px; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 2px solid var(--nav); line-height: 1; box-shadow: 0 0 0 1px rgba(229,57,53,0.4); }
        .profile { display: flex; align-items: center; gap: 10px; cursor: pointer; }
        .profile img { width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--accent); }
        .profile span { display: none; } @media (min-width: 480px) { .profile span { display: inline; } }
        .sidebar { position: fixed; left: -280px; top: 0; width: 280px; height: 100%; background: var(--nav); padding: 24px 20px; transition: 0.3s; z-index: 1200; border-right: 1px solid var(--border); overflow-y: auto; }
        .sidebar.active { left: 0; }
        .sidebar a { display: flex; align-items: center; gap: 14px; padding: 12px 16px; margin-bottom: 8px; color: var(--sub); text-decoration: none; border-radius: 14px; }
        .sidebar a:hover { background: var(--accent); color: #fff; }
        .overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); backdrop-filter: blur(2px); display: none; z-index: 1100; }
        .overlay.active { display: block; }
        .main-container { max-width: 600px; margin: 0 auto; padding: 0 0 80px; }
        
        /* Chat List Header */
        .chat-list-header { padding: 20px 18px 10px; display: flex; justify-content: space-between; align-items: center; }
        .chat-list-header h2 { font-size: 22px; font-weight: 600; }
        .new-chat-btn { background: var(--accent); color: white; padding: 10px 16px; border-radius: 30px; text-decoration: none; font-size: 14px; font-weight: 500; display: flex; align-items: center; gap: 6px; }
        
        /* Search Bar */
        .search-box { padding: 10px 18px; }
        .search-box input { width: 100%; padding: 14px 18px; background: var(--card); border: 1px solid var(--border); border-radius: 30px; color: var(--text); outline: none; font-size: 14px; }
        .search-box input::placeholder { color: var(--sub); }
        
        /* Chat List */
        .chat-list { padding: 0; }
        .chat-item { display: flex; align-items: center; gap: 15px; padding: 16px 18px; background: transparent; border-bottom: 1px solid var(--border); cursor: pointer; transition: 0.2s; }
        .chat-item:hover { background: rgba(0,195,255,0.05); }
        .chat-item.unread { background: rgba(0,195,255,0.08); }
        .chat-avatar { width: 52px; height: 52px; border-radius: 50%; background: var(--success); display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 20px; color: white; flex-shrink: 0; }
        .chat-content { flex: 1; min-width: 0; }
        .chat-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px; }
        .chat-name { font-weight: 600; font-size: 16px; }
        .chat-time { font-size: 11px; color: var(--sub); }
        .chat-bottom { display: flex; justify-content: space-between; align-items: center; }
        .chat-preview { color: var(--sub); font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 200px; }
        .chat-status { display: flex; align-items: center; gap: 5px; }
        .unread-badge { background: var(--accent); color: white; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 20px; min-width: 20px; text-align: center; }
        .status-badge { padding: 3px 8px; border-radius: 20px; font-size: 10px; font-weight: 600; }
        .status-pending { background: var(--warning); color: black; }
        .status-replied { background: var(--success); color: white; }
        .status-resolved { background: #888; color: white; }
        .status-read { background: var(--info); color: white; }
        
        .empty-state { text-align: center; padding: 60px 20px; color: var(--sub); }
        .btn { background: linear-gradient(135deg, var(--accent), #2c6e9e); border: none; padding: 14px 28px; border-radius: 40px; color: white; font-weight: 600; cursor: pointer; display: inline-block; text-decoration: none; }
        
        .bottom-nav { position: fixed; bottom: 0; width: 100%; background: var(--nav); display: flex; justify-content: space-around; padding: 8px 12px 12px; border-top: 1px solid var(--border); z-index: 100; }
        .nav-item { text-align: center; font-size: 12px; color: var(--sub); text-decoration: none; }
        .nav-item span { font-size: 26px; display: block; }
        .nav-item.active-nav { color: var(--accent); }
    </style>
</head>
<body>
    <div class="sidebar" id="sidebar">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px;">
            <img src="/images/logo.png" style="width:28px;height:28px;" onerror="this.src='https://via.placeholder.com/28/00c3ff/ffffff?text=SC'">
            <h3 style="color:var(--accent);margin:0;">Shubham Computer</h3>
        </div>
        <a href="/home"><span class="material-symbols-rounded">home</span>Home</a>
        <a href="/profile"><span class="material-symbols-rounded">person</span>My Profile</a>
        <a href="/requests"><span class="material-symbols-rounded">history</span>My Requests</a>
        <a href="/upload-page"><span class="material-symbols-rounded">cloud_upload</span>Upload</a>
        <a href="/payments"><span class="material-symbols-rounded">payments</span>Payments</a>
        <a href="/apply"><span class="material-symbols-rounded">description</span>Apply</a>
        <a href="/notifications"><span class="material-symbols-rounded">notifications</span>Notifications
            <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
            <span style="background:var(--danger);color:white;padding:2px 8px;border-radius:20px;font-size:11px;margin-left:auto;"><%= unreadCount %></span>
            <% } %>
        </a>
        <a href="/certificates"><span class="material-symbols-rounded">verified</span>My Certificates</a>
        <a href="/announcements"><span class="material-symbols-rounded">campaign</span>Announcements</a>
        <a href="/messages"><span class="material-symbols-rounded">mail</span>My Messages</a>
        <a href="/support"><span class="material-symbols-rounded">support_agent</span>Support</a>
        <a href="/logout" style="margin-top:30px;color:var(--danger);"><span class="material-symbols-rounded">logout</span>Logout</a>
    </div>
    <div class="overlay" id="overlay" onclick="toggleSidebar()"></div>
    
    <div class="header">
        <span class="material-symbols-rounded menu-btn" onclick="toggleSidebar()">menu</span>
        <div class="header-right">
            <a href="/notifications" class="notification-bell">
                <span class="material-symbols-rounded">notifications</span>
                <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
                <span class="badge-notification"><%= unreadCount > 9 ? '9+' : unreadCount %></span>
                <% } %>
            </a>
            <div class="profile" onclick="window.location.href='/profile'">
                <span><%= user.fullName %></span>
                <img src="<%= user.profileImage || 'https://i.pravatar.cc/100?img=7' %>" alt="avatar">
            </div>
        </div>
    </div>
    
    <div class="main-container">
        <div class="chat-list-header">
            <h2>Messages</h2>
            <a href="/support" class="new-chat-btn">
                <span class="material-symbols-rounded" style="font-size: 18px;">add</span> New
            </a>
        </div>
        
        <div class="search-box">
            <input type="text" id="searchInput" placeholder="🔍 Search messages..." onkeyup="filterMessages()">
        </div>
        
        <div class="chat-list" id="chatList">
            <% if (messages && messages.length > 0) { %>
                <% messages.forEach(m => { 
                    const isUnread = m.status === 'pending' || m.status === 'read';
                    const lastMessage = m.adminReply || m.message;
                    const lastMessageTime = m.adminReply ? m.repliedAt : m.createdAt;
                %>
                <div class="chat-item <%= isUnread ? 'unread' : '' %>" onclick="location.href='/messages/<%= m._id %>'" data-subject="<%= m.subject.toLowerCase() %>" data-message="<%= m.message.toLowerCase() %>">
                    <div class="chat-avatar">S</div>
                    <div class="chat-content">
                        <div class="chat-top">
                            <span class="chat-name"><%= m.subject %></span>
                            <span class="chat-time"><%= new Date(lastMessageTime).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></span>
                        </div>
                        <div class="chat-bottom">
                            <span class="chat-preview"><%= lastMessage.substring(0, 35) %>...</span>
                            <div class="chat-status">
                                <% if (m.status === 'replied' && !m.adminReply) { %>
                                    <span class="unread-badge">1</span>
                                <% } %>
                                <span class="status-badge status-<%= m.status %>"><%= m.status %></span>
                            </div>
                        </div>
                    </div>
                </div>
                <% }) %>
            <% } else { %>
                <div class="empty-state">
                    <span class="material-symbols-rounded" style="font-size: 60px; color: var(--sub);">chat</span>
                    <h3>No Messages Yet</h3>
                    <p style="margin: 20px 0 30px;">Start a conversation with our support team</p>
                    <a href="/support" class="btn">Send a Message</a>
                </div>
            <% } %>
        </div>
    </div>
    
    <div class="bottom-nav">
        <a href="/home" class="nav-item"><span class="material-symbols-rounded">home</span>Home</a>
        <a href="/apply" class="nav-item"><span class="material-symbols-rounded">description</span>Apply</a>
        <a href="/requests" class="nav-item"><span class="material-symbols-rounded">history</span>Requests</a>
        <a href="/profile" class="nav-item"><span class="material-symbols-rounded">person</span>Profile</a>
    </div>
    
    <script>
        function toggleSidebar() { 
            document.getElementById('sidebar').classList.toggle('active'); 
            document.getElementById('overlay').classList.toggle('active'); 
        }
        
        function filterMessages() {
            const term = document.getElementById('searchInput').value.toLowerCase();
            document.querySelectorAll('.chat-item').forEach(item => {
                const subject = item.dataset.subject || '';
                const message = item.dataset.message || '';
                if (subject.includes(term) || message.includes(term)) {
                    item.style.display = 'flex';
                } else {
                    item.style.display = 'none';
                }
            });
        }
        
        async function updateUnreadCount() { 
            try { 
                const r = await fetch('/api/unread-count'); 
                const d = await r.json(); 
                const b = document.querySelector('.badge-notification'); 
                if (b) { 
                    if (d.count > 0) { 
                        b.textContent = d.count > 9 ? '9+' : d.count; 
                        b.style.display = 'flex'; 
                    } else { 
                        b.style.display = 'none'; 
                    } 
                } 
            } catch(e) {} 
        }
        
        setInterval(updateUnreadCount, 30000); 
        updateUnreadCount();
    </script>
</body>
</html>