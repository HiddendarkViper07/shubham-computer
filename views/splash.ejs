<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shubham Computer - Loading</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Poppins', sans-serif; }
        body { height: 100vh; display: flex; justify-content: center; align-items: center; flex-direction: column; background: radial-gradient(circle at top, #0f2027, #000000); color: #fff; }
        .logo-wrapper { display: flex; flex-direction: column; align-items: center; }
        .logo { width: 110px; height: 110px; object-fit: contain; margin-bottom: 12px; filter: drop-shadow(0 0 12px #00c3ff88); animation: fadeIn 1s ease-in-out; }
        .brand-name { font-size: 28px; font-weight: 600; animation: fadeIn 1.5s ease-in-out; }
        .brand-tag { font-size: 14px; color: #aaa; margin-bottom: 30px; animation: fadeIn 2s ease-in-out; }
        .loader { width: 45px; height: 45px; border: 4px solid rgba(255,255,255,0.1); border-top: 4px solid #00c3ff; border-radius: 50%; animation: spin 1s linear infinite; }
        .loading-text { margin-top: 15px; font-size: 12px; color: #aaa; letter-spacing: 1px; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
<body>
    <div class="logo-wrapper">
        <img src="/images/logo.png" class="logo" alt="logo" onerror="this.src='https://via.placeholder.com/110/00c3ff/ffffff?text=SC'">
        <div class="brand-name">Shubham Computer</div>
        <div class="brand-tag">Your Digital Service Partner</div>
    </div>
    <div class="loader"></div>
    <div class="loading-text">Loading your experience...</div>
    <script>setTimeout(() => { window.location.href = "/login"; }, 2500);</script>
</body>
</html>