<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Apply for <%= service.serviceName %> - Shubham Computer</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0,1" rel="stylesheet" />
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Poppins', sans-serif; }
        :root { --bg: #0f2027; --bg2: #000000; --card: #ffffff0a; --card-solid: #1e2a32; --text: #ffffff; --sub: #aaaaaa; --accent: #00c3ff; --nav: #0c1a20; --border: rgba(255,255,255,0.08); --danger: #ff4d4d; --success: #2ecc71; --warning: #ffaa44; }
        body { background: radial-gradient(circle at 10% 20%, var(--bg), var(--bg2)); color: var(--text); min-height: 100vh; padding-bottom: 70px; }
        .header { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; background: var(--nav); border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 100; }
        .menu-btn { font-size: 28px; cursor: pointer; }
        .header-right { display: flex; align-items: center; gap: 15px; }
        .notification-bell { position: relative; cursor: pointer; text-decoration: none; color: var(--text); display: inline-flex; align-items: center; justify-content: center; }
        .notification-bell span.material-symbols-rounded { font-size: 28px; }
        .badge-notification { position: absolute; top: -6px; right: -8px; background: #e53935; color: white; font-size: 11px; font-weight: 700; width: 20px; height: 20px; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 2px solid var(--nav); line-height: 1; box-shadow: 0 0 0 1px rgba(229,57,53,0.4); } .profile { display: flex; align-items: center; gap: 10px; cursor: pointer; }
        .profile img { width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--accent); }
        .profile span { display: none; } @media (min-width: 480px) { .profile span { display: inline; } }
        .sidebar { position: fixed; left: -280px; top: 0; width: 280px; height: 100%; background: var(--nav); padding: 24px 20px; transition: 0.3s; z-index: 1200; border-right: 1px solid var(--border); overflow-y: auto; }
        .sidebar.active { left: 0; }
        .sidebar a { display: flex; align-items: center; gap: 14px; padding: 12px 16px; margin-bottom: 8px; color: var(--sub); text-decoration: none; border-radius: 14px; }
        .sidebar a:hover { background: var(--accent); color: #fff; }
        .overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); backdrop-filter: blur(2px); display: none; z-index: 1100; }
        .overlay.active { display: block; }
        .main-container { max-width: 600px; margin: 0 auto; padding: 20px 18px 80px; }
        .section-title { font-size: 18px; font-weight: 600; margin: 24px 0 12px; color: var(--accent); }
        .card { background: var(--card); backdrop-filter: blur(4px); border-radius: 24px; padding: 20px; border: 1px solid var(--border); margin-bottom: 16px; }
        .form-group { margin-bottom: 20px; }
        label { display: block; margin-bottom: 8px; font-size: 14px; color: var(--sub); }
        input, textarea { width: 100%; padding: 14px 16px; background: rgba(0,0,0,0.2); border: 1px solid var(--border); border-radius: 16px; color: var(--text); outline: none; font-size: 15px; }
        input:focus, textarea:focus { border-color: var(--accent); }
        .file-upload-box { border: 2px dashed var(--border); border-radius: 16px; padding: 20px; text-align: center; cursor: pointer; margin-bottom: 10px; transition: 0.3s; position: relative; }
        .file-upload-box:hover { border-color: var(--accent); background: rgba(0,195,255,0.05); }
        .file-upload-box.uploaded { border-color: var(--success); background: rgba(46,204,113,0.05); }
        .file-upload-box.uploading { border-color: var(--warning); }
        .file-upload-box .progress-container { margin-top: 10px; display: none; }
        .file-upload-box .progress-bar-bg { background: rgba(255,255,255,0.1); height: 4px; border-radius: 2px; overflow: hidden; }
        .file-upload-box .progress-bar-fill { height: 100%; background: var(--success); width: 0%; transition: width 0.3s; }
        .file-upload-box .progress-text { font-size: 11px; color: var(--sub); margin-top: 5px; }
        .btn { background: linear-gradient(135deg, var(--accent), #2c6e9e); border: none; padding: 16px; border-radius: 40px; color: white; font-weight: 600; cursor: pointer; width: 100%; font-size: 16px; }
        .btn:disabled { opacity: 0.6; cursor: not-allowed; }
        .service-price { color: var(--accent); font-weight: 600; }
        .bottom-nav { position: fixed; bottom: 0; width: 100%; background: var(--nav); display: flex; justify-content: space-around; padding: 8px 12px 12px; border-top: 1px solid var(--border); z-index: 100; }
        .nav-item { text-align: center; font-size: 12px; color: var(--sub); text-decoration: none; }
        .nav-item span { font-size: 26px; display: block; }
        .nav-item.active-nav { color: var(--accent); }
        .upload-stats { display: flex; justify-content: space-between; margin: 15px 0; padding: 10px; background: rgba(0,195,255,0.1); border-radius: 12px; }
        .toast { position: fixed; bottom: 100px; left: 50%; transform: translateX(-50%); background: var(--card-solid); color: white; padding: 12px 24px; border-radius: 40px; z-index: 9999; border: 1px solid var(--accent); }
        .loading-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); display: none; align-items: center; justify-content: center; z-index: 2000; }
        .loading-spinner { text-align: center; }
        .loading-spinner .spinner { width: 50px; height: 50px; border: 4px solid rgba(255,255,255,0.1); border-top-color: var(--accent); border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 20px; }
        @keyframes spin { to { transform: rotate(360deg); } }
        .payment-info { background: rgba(0,195,255,0.1); padding: 12px 16px; border-radius: 12px; margin-top: 15px; text-align: center; }
        .payment-info.free { background: rgba(46,204,113,0.1); border: 1px solid var(--success); }
    </style>
</head>
<body>
    <div class="sidebar" id="sidebar">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px;"><img src="/images/logo.png" style="width:28px;height:28px;" onerror="this.src='https://via.placeholder.com/28/00c3ff/ffffff?text=SC'"><h3 style="color:var(--accent);margin:0;">Shubham Computers</h3></div>
        <a href="/home"><span class="material-symbols-rounded">home</span>Home</a>
        <a href="/profile"><span class="material-symbols-rounded">person</span>My Profile</a>
        <a href="/requests"><span class="material-symbols-rounded">history</span>My Requests</a>
        <a href="/upload-page"><span class="material-symbols-rounded">cloud_upload</span>Upload</a>
        <a href="/payments"><span class="material-symbols-rounded">payments</span>Payments</a>
        <a href="/apply"><span class="material-symbols-rounded">description</span>Apply</a>
        <a href="/notifications"><span class="material-symbols-rounded">notifications</span>Notifications<% if (unreadCount > 0) { %><span style="background:var(--danger);color:white;padding:2px 8px;border-radius:20px;font-size:11px;margin-left:auto;"><%= unreadCount %></span><% } %></a>
        <a href="/certificates"><span class="material-symbols-rounded">verified</span>My Certificates</a>
        <a href="/announcements"><span class="material-symbols-rounded">campaign</span>Announcements</a>
        <a href="/support"><span class="material-symbols-rounded">support_agent</span>Support</a>
        <a href="/logout" style="margin-top:30px;color:var(--danger);"><span class="material-symbols-rounded">logout</span>Logout</a>
    </div>
    <div class="overlay" id="overlay" onclick="toggleSidebar()"></div>
    
    <div class="header">
        <span class="material-symbols-rounded menu-btn" onclick="toggleSidebar()">menu</span>
        <div class="header-right">
            <a href="/notifications" class="notification-bell"><span class="material-symbols-rounded">notifications</span><% if (unreadCount > 0) { %><span class="badge-notification"><%= unreadCount>9?'9+':unreadCount %></span><% } %></a>
            <div class="profile" onclick="window.location.href='/profile'"><span><%= user.fullName %></span><img src="<%= user.profileImage || 'https://i.pravatar.cc/100?img=7' %>" alt="avatar"></div>
        </div>
    </div>
    
    <div class="main-container">
        <div class="section-title"><a href="/apply" style="color:var(--sub);text-decoration:none;margin-right:10px;">←</a>Apply for <%= service.serviceName %></div>
        <div class="card">
            <p style="color:var(--sub);"><%= service.description || 'Complete the form below to apply' %></p>
            <div style="display:flex;gap:20px;margin-top:15px;">
                <span class="service-price">💰 ₹<%= service.processingFee %></span>
                <span style="color:var(--sub);">⏱️ <%= service.estimatedDays %> days</span>
            </div>
            <% if (!paymentEnabled) { %>
            <div class="payment-info free">
                <span>🎉 Payments are currently disabled. You can apply for free!</span>
            </div>
            <% } else if (activeGateway === 'easebuzz') { %>
            <div class="payment-info">
                <span>🏦 Payment via Easebuzz</span>
            </div>
            <% } %>
        </div>
        
        <form id="applicationForm" enctype="multipart/form-data">
            <input type="hidden" name="serviceId" value="<%= service._id %>">
            <input type="hidden" name="serviceName" id="serviceNameInput" value="<%= service.serviceName %>">
            <input type="hidden" name="processingFee" value="<%= service.processingFee %>">
            
            <div class="card"><h3 style="margin-bottom:20px;">📋 Personal Information</h3>
                <div class="form-group"><label>Full Name *</label><input type="text" name="fullName" id="fullName" value="<%= user.fullName %>" required></div>
                <div class="form-group"><label>Email *</label><input type="email" name="email" id="email" value="<%= user.email %>" required></div>
                <div class="form-group"><label>Mobile *</label><input type="tel" name="mobile" id="mobile" value="<%= user.mobile || '' %>" required></div>
                <div class="form-group"><label>Address *</label><textarea name="address" id="address" rows="3" required placeholder="Enter your complete address"></textarea></div>
            </div>
            
            <div class="card"><h3 style="margin-bottom:20px;">📎 Required Documents</h3><p style="color:var(--sub);font-size:13px;margin-bottom:10px;">Files upload automatically (Max 2MB each)</p>
                <div class="upload-stats" id="uploadStats" style="display:none;"><span>📊 Upload Progress</span><span id="uploadCount">0/0</span></div>
                <div id="documentsSection"></div>
                <div id="overallProgress" style="margin-top:15px;display:none;"><div style="display:flex;justify-content:space-between;margin-bottom:5px;"><span style="font-size:12px;">Overall</span><span id="overallPercent" style="font-size:12px;">0%</span></div><div style="background:rgba(255,255,255,0.1);height:6px;border-radius:3px;overflow:hidden;"><div id="overallBar" style="width:0%;height:100%;background:var(--accent);transition:width 0.3s;"></div></div></div>
            </div>
            
            <div class="card"><div class="form-group"><label>Additional Note</label><textarea name="note" id="note" rows="3" placeholder="Any additional information..."></textarea></div></div>
            
            <div class="card">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:20px;"><input type="checkbox" id="agreeTerms" required style="width:auto;"><label for="agreeTerms" style="margin:0;">I agree to terms</label></div>
                <button type="submit" class="btn" id="submitBtn" disabled>Upload all documents</button>
            </div>
        </form>
    </div>
    
    <div class="bottom-nav">
        <a href="/home" class="nav-item"><span class="material-symbols-rounded">home</span>Home</a>
        <a href="/apply" class="nav-item active-nav"><span class="material-symbols-rounded">description</span>Apply</a>
        <a href="/requests" class="nav-item"><span class="material-symbols-rounded">history</span>Requests</a>
        <a href="/profile" class="nav-item"><span class="material-symbols-rounded">person</span>Profile</a>
    </div>
    
    <!-- Loading Overlay -->
    <div class="loading-overlay" id="loadingOverlay">
        <div class="loading-spinner">
            <div class="spinner"></div>
            <p style="color: white;" id="loadingText">Processing...</p>
        </div>
    </div>
    
    <script>
        // Payment configuration from server
        const PAYMENT_ENABLED = <%= paymentEnabled %>;
        const ACTIVE_GATEWAY = '<%= activeGateway %>';
        const GATEWAY_CONFIG = <%- JSON.stringify(gatewayConfig) %>;
        
        const serviceConfig = <%- JSON.stringify(service) %>;
        let uploadedFiles = {}, totalRequiredDocs = 0, uploadingCount = 0;
        
        function toggleSidebar() { document.getElementById('sidebar').classList.toggle('active'); document.getElementById('overlay').classList.toggle('active'); }
        function showLoading(text) { document.getElementById('loadingText').textContent = text; document.getElementById('loadingOverlay').style.display = 'flex'; }
        function hideLoading() { document.getElementById('loadingOverlay').style.display = 'none'; }
        
        function renderDocuments() {
            const reqDocs = serviceConfig.requiredDocuments.filter(d => d.isRequired); 
            totalRequiredDocs = reqDocs.length;
            const docSection = document.getElementById('documentsSection');
            
            if (!reqDocs.length) { 
                docSection.innerHTML = '<p style="color:var(--sub);text-align:center;">No documents required</p>'; 
                document.getElementById('submitBtn').disabled = false; 
                updateSubmitButtonText(); 
                return; 
            }
            
            docSection.innerHTML = reqDocs.map((doc, idx) => { 
                const docId = 'doc_'+idx; 
                uploadedFiles[docId] = { file: null, uploaded: false, fileId: null }; 
                return `<div class="form-group"><label>${doc.name} *</label><div class="file-upload-box" id="box_${docId}" onclick="document.getElementById('file_${docId}').click()"><span class="material-symbols-rounded" style="font-size:28px;color:var(--accent);">cloud_upload</span><p id="label_${docId}">Click to upload ${doc.name}</p><p style="font-size:11px;color:var(--sub);">Max ${doc.maxSize||2}MB</p><div class="progress-container" id="progress_${docId}"><div class="progress-bar-bg"><div class="progress-bar-fill" id="bar_${docId}"></div></div><div class="progress-text" id="percent_${docId}">0%</div></div></div><input type="file" id="file_${docId}" accept="image/*,application/pdf" style="display:none;"></div>`; 
            }).join('');
            
            reqDocs.forEach((doc, idx) => { 
                const docId = 'doc_'+idx; 
                document.getElementById('file_'+docId).addEventListener('change', (e) => { 
                    if(e.target.files[0]) uploadFile(docId, doc.name, e.target.files[0]); 
                }); 
            });
            updateUploadStats();
        }
        
        function updateSubmitButtonText() {
            const btn = document.getElementById('submitBtn');
            const fee = parseInt(document.querySelector('[name="processingFee"]').value)||50;
            if (!PAYMENT_ENABLED || ACTIVE_GATEWAY === 'none') {
                btn.textContent = 'Submit Application (Free)';
            } else {
                btn.textContent = `Proceed to Pay ₹${fee}`;
            }
        }
        
        async function uploadFile(docId, docName, file) {
            if (file.size > 2*1024*1024) { showToast('❌ Max 2MB', 'error'); document.getElementById('file_'+docId).value = ''; return; }
            const box = document.getElementById('box_'+docId), label = document.getElementById('label_'+docId), progressDiv = document.getElementById('progress_'+docId), bar = document.getElementById('bar_'+docId), percent = document.getElementById('percent_'+docId);
            box.classList.add('uploading'); progressDiv.style.display = 'block'; label.innerHTML = `⏳ Uploading ${file.name}...`;
            const formData = new FormData(); formData.append('file', file);
            uploadingCount++; updateUploadStats();
            try {
                const xhr = new XMLHttpRequest();
                xhr.upload.addEventListener('progress', (e) => { if(e.lengthComputable) { const pct = Math.round((e.loaded/e.total)*100); bar.style.width = pct+'%'; percent.textContent = pct+'%'; } });
                xhr.onload = () => { 
                    if(xhr.status===200) { 
                        const data = JSON.parse(xhr.responseText); 
                        uploadedFiles[docId] = { file, uploaded: true, fileId: data.fileId }; 
                        box.classList.remove('uploading'); box.classList.add('uploaded'); 
                        label.innerHTML = `✅ ${file.name} (${(file.size/1024).toFixed(2)} KB)`; 
                        progressDiv.style.display = 'none'; 
                        showToast(`✅ ${docName} uploaded`, 'success'); 
                    } else { 
                        handleError(docId, docName); 
                    } 
                    uploadingCount--; updateUploadStats(); updateOverallProgress(); 
                };
                xhr.onerror = () => { handleError(docId, docName); uploadingCount--; updateUploadStats(); updateOverallProgress(); };
                xhr.open('POST', '/upload/single'); xhr.send(formData);
            } catch(e) { handleError(docId, docName); uploadingCount--; updateUploadStats(); updateOverallProgress(); }
        }
        
        function handleError(docId, docName) { 
            const box = document.getElementById('box_'+docId), label = document.getElementById('label_'+docId); 
            box.classList.remove('uploading'); 
            label.innerHTML = `❌ Failed - Click to retry`; 
            uploadedFiles[docId] = { file: null, uploaded: false, fileId: null }; 
            showToast(`❌ Failed to upload ${docName}`, 'error'); 
        }
        
        function updateUploadStats() { 
            const cnt = Object.values(uploadedFiles).filter(f=>f.uploaded).length; 
            document.getElementById('uploadStats').style.display = totalRequiredDocs?'flex':'none'; 
            document.getElementById('uploadCount').textContent = `${cnt}/${totalRequiredDocs}`; 
        }
        
        function updateOverallProgress() { 
            const cnt = Object.values(uploadedFiles).filter(f=>f.uploaded).length; 
            const pct = totalRequiredDocs ? Math.round((cnt/totalRequiredDocs)*100) : 0; 
            document.getElementById('overallProgress').style.display = (uploadingCount||cnt) ? 'block' : 'none'; 
            document.getElementById('overallBar').style.width = pct+'%'; 
            document.getElementById('overallPercent').textContent = pct+'%'; 
            const btn = document.getElementById('submitBtn'); 
            if(cnt === totalRequiredDocs && totalRequiredDocs > 0) { 
                btn.disabled = false; 
                updateSubmitButtonText();
            } else { 
                btn.disabled = true; 
                btn.textContent = uploadingCount ? `Uploading (${cnt}/${totalRequiredDocs})` : `Upload all (${cnt}/${totalRequiredDocs})`; 
            } 
        }
        
        function showToast(msg, type) { 
            const t = document.createElement('div'); 
            t.className = 'toast'; 
            t.style.background = type==='success' ? '#2ecc71' : type==='error' ? '#ff4d4d' : '#00c3ff'; 
            t.textContent = msg; 
            document.body.appendChild(t); 
            setTimeout(()=>t.remove(), 3000); 
        }
        
        document.getElementById('applicationForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const fullName = document.getElementById('fullName').value.trim();
            const email = document.getElementById('email').value.trim();
            const mobile = document.getElementById('mobile').value.trim();
            const address = document.getElementById('address').value.trim();
            const serviceName = document.getElementById('serviceNameInput').value;
            
            console.log('Form data:', { serviceName, fullName, email, mobile, address });
            
            if (!fullName || !email || !mobile || !address) { 
                showToast('❌ Please fill all required fields', 'error'); 
                return; 
            }
            
            if (!serviceName) {
                showToast('❌ Service name is missing', 'error');
                return;
            }
            
            const reqDocs = serviceConfig.requiredDocuments.filter(d=>d.isRequired); 
            let missing = [];
            for(let i=0; i<reqDocs.length; i++) {
                if(!uploadedFiles['doc_'+i]?.uploaded) missing.push(reqDocs[i].name);
            }
            if(missing.length) { 
                showToast('❌ Upload all documents:\n- ' + missing.join('\n- '), 'error'); 
                return; 
            }
            
            const fee = parseInt(document.querySelector('[name="processingFee"]').value) || 50;
            const btn = document.getElementById('submitBtn');
            
            // FREE APPLICATION FLOW
            if (!PAYMENT_ENABLED || ACTIVE_GATEWAY === 'none') {
                btn.textContent = 'Submitting...';
                btn.disabled = true;
                showLoading('Submitting application...');
                
                const formData = new FormData(); 
                formData.append('serviceName', serviceName); 
                formData.append('fullName', fullName); 
                formData.append('email', email); 
                formData.append('mobile', mobile); 
                formData.append('address', address); 
                formData.append('note', document.getElementById('note').value); 
                formData.append('paymentSkipped', 'true');
                
                const fileIds = Object.values(uploadedFiles).filter(f=>f.uploaded).map(f=>f.fileId); 
                formData.append('fileIds', JSON.stringify(fileIds));
                
                try {
                    const res = await fetch('/api/submit-request', { method: 'POST', body: formData }); 
                    const data = await res.json();
                    hideLoading();
                    if(data.success) { 
                        showToast('✅ Application submitted!', 'success'); 
                        setTimeout(()=>{ window.location.href = `/application-success?requestId=${data.requestId}&service=${encodeURIComponent(serviceName)}`; }, 1000); 
                    } else { 
                        showToast('❌ '+ (data.error||'Failed'), 'error'); 
                        btn.disabled = false;
                        updateSubmitButtonText();
                    }
                } catch(e) { 
                    hideLoading();
                    showToast('❌ Error', 'error'); 
                    btn.disabled = false;
                    updateSubmitButtonText();
                }
                return;
            }
            
            // RAZORPAY FLOW
            if (ACTIVE_GATEWAY === 'razorpay') {
                const RAZORPAY_KEY_ID = GATEWAY_CONFIG.razorpayKeyId;
                if (!RAZORPAY_KEY_ID) { 
                    showToast('❌ Razorpay not configured', 'error'); 
                    return; 
                }
                
                showLoading('Creating order...');
                btn.disabled = true;
                
                try {
                    const orderRes = await fetch('/api/create-order', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ amount: fee, currency: 'INR' })
                    });
                    const orderData = await orderRes.json();
                    
                    if (!orderData.success) throw new Error(orderData.error);
                    
                    hideLoading();
                    
                    const options = {
                        key: RAZORPAY_KEY_ID,
                        amount: orderData.amount,
                        currency: orderData.currency,
                        name: 'Shubham Computer',
                        description: `Fee - ${serviceName}`,
                        order_id: orderData.orderId,
                        handler: async (response) => {
                            showLoading('Verifying payment...');
                            try {
                                const verifyRes = await fetch('/api/verify-payment', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({
                                        razorpay_order_id: response.razorpay_order_id,
                                        razorpay_payment_id: response.razorpay_payment_id,
                                        razorpay_signature: response.razorpay_signature
                                    })
                                });
                                const verifyData = await verifyRes.json();
                                if (verifyData.success) {
                                    document.getElementById('loadingText').textContent = 'Submitting application...';
                                    await submitApplication(response, serviceName, fullName, email, mobile, address);
                                } else {
                                    hideLoading();
                                    showToast('❌ Verification failed', 'error');
                                    btn.disabled = false;
                                    updateSubmitButtonText();
                                }
                            } catch (err) {
                                hideLoading();
                                showToast('❌ Verification error', 'error');
                                btn.disabled = false;
                                updateSubmitButtonText();
                            }
                        },
                        prefill: { name: fullName, email: email, contact: mobile },
                        theme: { color: '#00c3ff' },
                        modal: { ondismiss: () => { hideLoading(); btn.disabled = false; updateSubmitButtonText(); } }
                    };
                    new Razorpay(options).open();
                } catch (err) {
                    hideLoading();
                    showToast('❌ ' + err.message, 'error');
                    btn.disabled = false;
                    updateSubmitButtonText();
                }
                return;
            }
            
            // EASEBUZZ FLOW
            if (ACTIVE_GATEWAY === 'easebuzz') {
                showToast('🏦 Easebuzz payment integration ready! Complete the flow.', 'info');
                return;
            }
        });
        
        async function submitApplication(payment, serviceName, fullName, email, mobile, address) {
            const formData = new FormData(); 
            formData.append('serviceName', serviceName); 
            formData.append('fullName', fullName); 
            formData.append('email', email); 
            formData.append('mobile', mobile); 
            formData.append('address', address); 
            formData.append('note', document.getElementById('note').value); 
            
            if (payment) {
                formData.append('razorpay_payment_id', payment.razorpay_payment_id);
                formData.append('razorpay_order_id', payment.razorpay_order_id);
                formData.append('razorpay_signature', payment.razorpay_signature);
            }
            
            const fileIds = Object.values(uploadedFiles).filter(f=>f.uploaded).map(f=>f.fileId); 
            formData.append('fileIds', JSON.stringify(fileIds));
            
            try {
                const res = await fetch('/api/submit-request', { method: 'POST', body: formData }); 
                const data = await res.json();
                hideLoading();
                if(data.success) { 
                    showToast('✅ Application submitted!', 'success'); 
                    setTimeout(()=>{ window.location.href = `/application-success?requestId=${data.requestId}&service=${encodeURIComponent(serviceName)}`; }, 1000); 
                } else { 
                    showToast('❌ '+ (data.error||'Failed'), 'error'); 
                    document.getElementById('submitBtn').disabled = false;
                    updateSubmitButtonText();
                }
            } catch(e) { 
                hideLoading();
                showToast('❌ Network error', 'error'); 
                document.getElementById('submitBtn').disabled = false;
                updateSubmitButtonText();
            }
        }
        
        async function updateUnreadCount() { 
            try { 
                const r = await fetch('/api/unread-count'); 
                const d = await r.json(); 
                const b = document.querySelector('.badge-notification'); 
                if(b) { 
                    if(d.count>0) { 
                        b.textContent = d.count>9?'9+':d.count; 
                        b.style.display='block'; 
                    } else { 
                        b.style.display='none'; 
                    } 
                } 
            } catch(e) {} 
        }
        
        renderDocuments(); 
        setInterval(updateUnreadCount, 30000); 
        updateUnreadCount();
    </script>
</body>
</html>