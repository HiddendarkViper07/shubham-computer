<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Details - Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded" rel="stylesheet" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Poppins', sans-serif; }
        :root { --bg: #0f2027; --bg2: #000000; --card: #1e2a32; --text: #ffffff; --sub: #aaaaaa; --accent: #ff4757; --nav: #0c1a20; --border: rgba(255,255,255,0.08); --success: #2ecc71; --warning: #ffaa44; --danger: #ff4d4d; }
        body { background: radial-gradient(circle at 10% 20%, var(--bg), var(--bg2)); color: var(--text); min-height: 100vh; }
        .admin-layout { display: flex; min-height: 100vh; }
        .admin-sidebar { width: 260px; background: var(--nav); border-right: 1px solid var(--border); padding: 24px 16px; position: fixed; height: 100vh; overflow-y: auto; }
        .admin-main { margin-left: 260px; flex: 1; padding: 24px; }
        .sidebar-header { padding-bottom: 24px; border-bottom: 1px solid var(--border); margin-bottom: 24px; }
        .sidebar-header h2 { color: var(--accent); font-size: 20px; }
        .nav-link { display: flex; align-items: center; gap: 12px; padding: 12px 16px; color: var(--sub); text-decoration: none; border-radius: 12px; margin-bottom: 4px; }
        .nav-link:hover, .nav-link.active { background: var(--accent); color: white; }
        .nav-link span { font-size: 22px; }
        .back-link { display: inline-block; margin-bottom: 24px; color: var(--sub); text-decoration: none; }
        .profile-header { display: flex; gap: 30px; margin-bottom: 30px; }
        .profile-avatar { width: 120px; height: 120px; border-radius: 50%; border: 3px solid var(--accent); }
        .profile-info h2 { margin-bottom: 8px; }
        .stats-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 30px; }
        .stat-card { background: var(--card); border-radius: 16px; padding: 20px; text-align: center; }
        .stat-value { font-size: 32px; font-weight: 700; color: var(--accent); }
        .stat-label { color: var(--sub); font-size: 13px; }
        .section-card { background: var(--card); border-radius: 16px; padding: 24px; margin-bottom: 24px; }
        .section-title { font-size: 18px; font-weight: 600; margin-bottom: 20px; display: flex; align-items: center; gap: 10px; }
        .info-row { display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid var(--border); }
        .info-label { color: var(--sub); }
        .badge { padding: 4px 12px; border-radius: 20px; font-size: 12px; }
        .badge-success { background: var(--success); color: white; }
        .badge-warning { background: var(--warning); color: black; }
        .action-btn { padding: 10px 20px; border-radius: 8px; border: none; cursor: pointer; background: var(--accent); color: white; margin-right: 10px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 12px; text-align: left; border-bottom: 1px solid var(--border); }
    </style>
</head>
<body>
    <div class="admin-layout">
        <div class="admin-sidebar">
            <div class="sidebar-header"><h2>Shubham Admin</h2><p><%= user.fullName %></p></div>
            <nav>
                <a href="/admin/dashboard" class="nav-link"><span class="material-symbols-rounded">dashboard</span>Dashboard</a>
                <a href="/admin/services" class="nav-link "><span class="material-symbols-rounded">settings</span>Services</a>
                <a href="/admin/users" class="nav-link active"><span class="material-symbols-rounded">group</span>Users</a>
                <a href="/admin/requests" class="nav-link"><span class="material-symbols-rounded">assignment</span>Requests</a>
                <a href="/admin/files" class="nav-link"><span class="material-symbols-rounded">folder</span>Files</a>
                <a href="/admin/announcements" class="nav-link"><span class="material-symbols-rounded">campaign</span>Announcements</a>
                <a href="/admin/messages" class="nav-link"><span class="material-symbols-rounded">mail</span>Messages</a>
                <a href="/admin/settings" class="nav-link"><span class="material-symbols-rounded">tune</span>Settings</a>
                <div style="margin-top:30px;"><a href="/home" class="nav-link">Back To Website</a><a href="/logout" class="nav-link" style="color:var(--danger);">Logout</a></div>
            </nav>
        </div>
        <div class="admin-main">
            <a href="/admin/users" class="back-link">← Back to Users</a>
            <div class="profile-header">
                <img src="<%= user.profileImage || 'https://i.pravatar.cc/150' %>" class="profile-avatar">
                <div class="profile-info"><h2><%= user.fullName %></h2><p><%= user.email %></p><p><%= user.mobile || 'No mobile' %></p><p>Joined: <%= new Date(user.createdAt).toLocaleDateString('en-IN') %></p></div>
            </div>
            <div class="stats-cards">
                <div class="stat-card"><div class="stat-value"><%= requests.length %></div><div class="stat-label">Total Requests</div></div>
                <div class="stat-card"><div class="stat-value"><%= requests.filter(r=>r.status==='completed').length %></div><div class="stat-label">Completed</div></div>
                <div class="stat-card"><div class="stat-value"><%= files.length %></div><div class="stat-label">Files</div></div>
            </div>
            <div class="section-card">
                <div class="section-title"><span class="material-symbols-rounded">person</span>Account Information</div>
                <div class="info-row"><span class="info-label">User ID</span><span><%= user._id %></span></div>
                <div class="info-row"><span class="info-label">Email Verified</span><span class="badge <%= user.isVerified?'badge-success':'badge-warning' %>"><%= user.isVerified?'Verified':'Pending' %></span></div>
                <div class="info-row"><span class="info-label">KYC Status</span><span class="badge badge-<%= user.kycStatus==='verified'?'success':'warning' %>"><%= user.kycStatus||'Pending' %></span></div>
                <div class="info-row"><span class="info-label">Role</span><span><%= user.role %></span></div>
                <div class="info-row"><span class="info-label">Last Login</span><span><%= user.lastLogin?new Date(user.lastLogin).toLocaleString('en-IN'):'Never' %></span></div>
            </div>
            <div class="section-card">
                <div class="section-title"><span class="material-symbols-rounded">assignment</span>Recent Requests</div>
                <% if (requests.length) { %>
                <table><thead><tr><th>Request ID</th><th>Service</th><th>Status</th><th>Date</th></tr></thead><tbody><% requests.slice(0,5).forEach(r=>{ %><tr><td><%= r.requestId %></td><td><%= r.serviceName %></td><td><span class="badge badge-<%= r.status==='completed'?'success':'warning' %>"><%= r.status %></span></td><td><%= new Date(r.createdAt).toLocaleDateString('en-IN') %></td></tr><% }) %></tbody></table>
                <% } else { %><p style="color:var(--sub);">No requests</p><% } %>
            </div>
            <div class="section-card">
                <div class="section-title"><span class="material-symbols-rounded">admin_panel_settings</span>Admin Actions</div>
                <button class="action-btn" style="background:var(--success);" onclick="updateKYC('verified')">Approve KYC</button>
                <button class="action-btn" style="background:var(--danger);" onclick="updateKYC('rejected')">Reject KYC</button>
                <button class="action-btn" style="background:transparent;border:1px solid var(--border);" onclick="alert('Password reset email sent')">Reset Password</button>
            </div>
        </div>
    </div>
    <script>
        async function updateKYC(status) { if(!confirm(`Set KYC to ${status}?`)) return; try { await fetch('/admin/users/<%= user._id %>/kyc', { method:'PUT', headers:{'Content-Type':'application/json'}, body:JSON.stringify({kycStatus:status}) }); alert('Updated!'); location.reload(); } catch(e) { alert('Error'); } }
    </script>
</body>
</html>