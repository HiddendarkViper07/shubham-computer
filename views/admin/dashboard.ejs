<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Shubham Computer</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded" rel="stylesheet" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Poppins', sans-serif; }
        :root { --bg: #0f2027; --bg2: #000000; --card: #1e2a32; --text: #ffffff; --sub: #aaaaaa; --accent: #ff4757; --nav: #0c1a20; --border: rgba(255,255,255,0.08); --success: #2ecc71; --warning: #ffaa44; --danger: #ff4d4d; }
        body { background: radial-gradient(circle at 10% 20%, var(--bg), var(--bg2)); color: var(--text); min-height: 100vh; }
        .admin-layout { display: flex; min-height: 100vh; }
        .admin-sidebar { width: 260px; background: var(--nav); border-right: 1px solid var(--border); padding: 24px 16px; position: fixed; height: 100vh; overflow-y: auto; }
        .admin-main { margin-left: 260px; flex: 1; padding: 24px; }
        .sidebar-header { padding-bottom: 24px; border-bottom: 1px solid var(--border); margin-bottom: 24px; }
        .sidebar-header h2 { color: var(--accent); font-size: 20px; }
        .nav-link { display: flex; align-items: center; gap: 12px; padding: 12px 16px; color: var(--sub); text-decoration: none; border-radius: 12px; margin-bottom: 4px; }
        .nav-link:hover, .nav-link.active { background: var(--accent); color: white; }
        .nav-link span { font-size: 22px; }
        .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 30px; }
        .stat-card { background: var(--card); border-radius: 20px; padding: 24px; border: 1px solid var(--border); }
        .stat-value { font-size: 36px; font-weight: 700; color: var(--accent); }
        .stat-label { color: var(--sub); font-size: 14px; margin-top: 8px; }
        .chart-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 20px; }
        .chart-card { background: var(--card); border-radius: 20px; padding: 24px; border: 1px solid var(--border); }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 12px; text-align: left; border-bottom: 1px solid var(--border); }
        th { color: var(--sub); font-weight: 500; font-size: 13px; }
        .badge { padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; }
        .badge-success { background: var(--success); color: white; }
        .badge-warning { background: var(--warning); color: black; }
    </style>
</head>
<body>
    <div class="admin-layout">
        <div class="admin-sidebar">
            <div class="sidebar-header"><h2>Shubham Admin</h2><p><%= user.fullName %></p></div>
            <nav>
                <a href="/admin/dashboard" class="nav-link active"><span class="material-symbols-rounded">dashboard</span>Dashboard</a>
                <a href="/admin/services" class="nav-link"><span class="material-symbols-rounded">settings</span>Services</a>
                <a href="/admin/users" class="nav-link"><span class="material-symbols-rounded">group</span>Users</a>
                <a href="/admin/requests" class="nav-link"><span class="material-symbols-rounded">assignment</span>Requests</a>
                <a href="/admin/files" class="nav-link"><span class="material-symbols-rounded">folder</span>Files</a>
                <a href="/admin/announcements" class="nav-link"><span class="material-symbols-rounded">campaign</span>Announcements</a>
                <a href="/admin/messages" class="nav-link"><span class="material-symbols-rounded">mail</span>Messages</a>
                <a href="/admin/settings" class="nav-link"><span class="material-symbols-rounded">tune</span>Settings</a>
                <div style="margin-top:30px;"><a href="/home" class="nav-link">Back To Website</a><a href="/logout" class="nav-link" style="color:var(--danger);">Logout</a></div>
            </nav>
        </div>
        <div class="admin-main">
            <h1>Dashboard</h1><p style="color:var(--sub);margin-bottom:30px;">System overview</p>
            <div class="stats-grid">
                <div class="stat-card"><div class="stat-value"><%= stats.totalUsers||0 %></div><div class="stat-label">Total Users</div></div>
                <div class="stat-card"><div class="stat-value"><%= stats.totalRequests||0 %></div><div class="stat-label">Total Requests</div></div>
                <div class="stat-card"><div class="stat-value"><%= stats.pendingRequests||0 %></div><div class="stat-label">Pending</div></div>
                <div class="stat-card"><div class="stat-value">₹<%= totalRevenue||0 %></div><div class="stat-label">Revenue</div></div>
            </div>
            <div class="chart-grid">
                <div class="chart-card"><h3>Recent Requests</h3><table><thead><tr><th>ID</th><th>Service</th><th>User</th><th>Status</th></tr></thead><tbody><% stats.recentRequests?.slice(0,5).forEach(r=>{ %><tr><td><%= r.requestId %></td><td><%= r.serviceName %></td><td><%= r.userName||r.userId?.fullName||'N/A' %></td><td><span class="badge badge-<%= r.status==='completed'?'success':'warning' %>"><%= r.status %></span></td></tr><% }) %></tbody></table></div>
                <div class="chart-card"><h3>Recent Users</h3><table><thead><tr><th>Name</th><th>Email</th></tr></thead><tbody><% stats.recentUsers?.forEach(u=>{ %><tr><td><%= u.fullName %></td><td><%= u.email %></td></tr><% }) %></tbody></table></div>
            </div>
        </div>
    </div>
</body>
</html>