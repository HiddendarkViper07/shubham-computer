<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Users - Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded" rel="stylesheet" />
    <link rel="stylesheet" href="/css/admin.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Poppins', sans-serif; }
        :root { --bg: #0f2027; --bg2: #000000; --card: #1e2a32; --text: #ffffff; --sub: #aaaaaa; --accent: #ff4757; --nav: #0c1a20; --border: rgba(255,255,255,0.08); --success: #2ecc71; --warning: #ffaa44; --danger: #ff4d4d; }
        body { background: radial-gradient(circle at 10% 20%, var(--bg), var(--bg2)); color: var(--text); min-height: 100vh; }
        .admin-layout { display: flex; min-height: 100vh; }
        .admin-sidebar { width: 260px; background: var(--nav); border-right: 1px solid var(--border); padding: 24px 16px; position: fixed; height: 100vh; overflow-y: auto; }
        .admin-main { margin-left: 260px; flex: 1; padding: 24px; }
        .sidebar-header { padding-bottom: 24px; border-bottom: 1px solid var(--border); margin-bottom: 24px; }
        .sidebar-header h2 { color: var(--accent); font-size: 20px; }
        .nav-link { display: flex; align-items: center; gap: 12px; padding: 12px 16px; color: var(--sub); text-decoration: none; border-radius: 12px; margin-bottom: 4px; }
        .nav-link:hover, .nav-link.active { background: var(--accent); color: white; }
        .nav-link span { font-size: 22px; }
        .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
        .search-section { display: flex; gap: 16px; margin-bottom: 24px; }
        .search-bar { flex: 1; display: flex; align-items: center; background: var(--card); border: 1px solid var(--border); border-radius: 40px; padding: 4px 4px 4px 20px; }
        .search-bar input { flex: 1; border: none; background: transparent; color: var(--text); padding: 10px 0; outline: none; }
        .search-bar button { padding: 10px 24px; border-radius: 40px; background: var(--accent); border: none; color: white; cursor: pointer; }
        .filter-select { padding: 10px 20px; background: var(--card); border: 1px solid var(--border); border-radius: 40px; color: var(--text); cursor: pointer; }
        table { width: 100%; border-collapse: collapse; background: var(--card); border-radius: 16px; overflow: hidden; }
        th, td { padding: 14px 16px; text-align: left; border-bottom: 1px solid var(--border); }
        th { color: var(--sub); font-weight: 500; font-size: 13px; background: rgba(0,0,0,0.2); }
        .badge { padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; }
        .badge-success { background: var(--success); color: white; }
        .badge-warning { background: var(--warning); color: black; }
        .badge-danger { background: var(--danger); color: white; }
        .action-btn { padding: 6px 12px; border-radius: 6px; border: none; cursor: pointer; font-size: 12px; margin: 2px; text-decoration: none; display: inline-block; }
        .btn-view { background: var(--accent); color: white; }
        .user-avatar { width: 35px; height: 35px; border-radius: 50%; object-fit: cover; }
        .pagination { display: flex; justify-content: center; gap: 10px; margin-top: 30px; }
        .pagination a { padding: 8px 16px; background: var(--card); color: var(--text); text-decoration: none; border-radius: 8px; border: 1px solid var(--border); }
        .pagination a.active { background: var(--accent); color: white; }
        .bulk-actions { display: none; position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%); background: var(--card); padding: 16px 30px; border-radius: 60px; border: 1px solid var(--accent); z-index: 500; gap: 20px; }
        .bulk-actions.show { display: flex; }
        .btn-danger { background: var(--danger); color: white; border: none; padding: 10px 20px; border-radius: 40px; cursor: pointer; }
    </style>
</head>
<body>
    <div class="admin-layout">
        <div class="admin-sidebar">
            <div class="sidebar-header"><h2>Shubham Admin</h2><p><%= user.fullName %></p></div>
            <nav>
                <a href="/admin/dashboard" class="nav-link"><span class="material-symbols-rounded">dashboard</span>Dashboard</a>
                <a href="/admin/services" class="nav-link"><span class="material-symbols-rounded">settings</span>Services</a>
                <a href="/admin/users" class="nav-link active"><span class="material-symbols-rounded">group</span>Users</a>
                <a href="/admin/requests" class="nav-link"><span class="material-symbols-rounded">assignment</span>Requests</a>
                <a href="/admin/files" class="nav-link"><span class="material-symbols-rounded">folder</span>Files</a>
                <a href="/admin/announcements" class="nav-link"><span class="material-symbols-rounded">campaign</span>Announcements</a>
                <a href="/admin/messages" class="nav-link"><span class="material-symbols-rounded">mail</span>Messages</a>
                <a href="/admin/settings" class="nav-link"><span class="material-symbols-rounded">tune</span>Settings</a>
                <div style="margin-top:30px;"><a href="/home" class="nav-link">Back To Website</a><a href="/logout" class="nav-link" style="color:var(--danger);">Logout</a></div>
            </nav>
        </div>
        <div class="admin-main">
            <div class="page-header"><div><h1>Manage Users</h1><p style="color:var(--sub);">Total <%= pagination.total %> users</p></div><button class="action-btn btn-view" style="padding:12px 24px;" onclick="showToast('Coming soon')">+ Add User</button></div>
            <div class="search-section">
                <div class="search-bar"><span class="material-symbols-rounded" style="color:var(--sub);">search</span><input type="text" id="searchInput" placeholder="Search by name or email..."><button onclick="searchUsers()">Search</button></div>
                <select class="filter-select" id="filterSelect"><option value="all">All Users</option><option value="verified">Verified</option><option value="pending">Pending KYC</option></select>
                <div style="display:flex;align-items:center;gap:10px;"><input type="checkbox" id="selectAll"><label for="selectAll">Select All</label></div>
            </div>
            <div style="background:var(--card);border-radius:16px;overflow:hidden;">
                <table>
                    <thead><tr><th style="width:50px;"><input type="checkbox" id="selectAllCheckbox"></th><th>User</th><th>Email</th><th>Mobile</th><th>KYC</th><th>Joined</th><th>Actions</th></tr></thead>
                    <tbody>
                        <% if (users && users.length) { %>
                            <% users.forEach(u => { %>
                            <tr>
                                <td><input type="checkbox" class="item-checkbox" value="<%= u._id %>"></td>
                                <td><div style="display:flex;align-items:center;gap:12px;"><img src="<%= u.profileImage || 'https://i.pravatar.cc/40' %>" class="user-avatar"><span><%= u.fullName %></span></div></td>
                                <td><%= u.email %></td>
                                <td><%= u.mobile || '-' %></td>
                                <td><span class="badge badge-<%= u.kycStatus==='verified'?'success':u.kycStatus==='pending'?'warning':'danger' %>"><%= u.kycStatus||'pending' %></span></td>
                                <td><%= new Date(u.createdAt).toLocaleDateString('en-IN') %></td>
                                <td><a href="/admin/users/<%= u._id %>" class="action-btn btn-view">View</a></td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="7" style="text-align:center;padding:60px;color:var(--sub);">No users found</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
            <% if (pagination && pagination.totalPages > 1) { %>
            <div class="pagination">
                <% if (pagination.page > 1) { %><a href="/admin/users?page=<%= pagination.page-1 %>">←</a><% } %>
                <% for(let i=1; i<=pagination.totalPages; i++) { %><a href="/admin/users?page=<%= i %>" class="<%= i===pagination.page?'active':'' %>"><%= i %></a><% } %>
                <% if (pagination.page < pagination.totalPages) { %><a href="/admin/users?page=<%= pagination.page+1 %>">→</a><% } %>
            </div>
            <% } %>
        </div>
    </div>
    <div class="bulk-actions" id="bulkActionsBar"><span><span id="selectedCount">0</span> selected</span><button class="btn-danger" onclick="bulkDelete()">Delete Selected</button><button onclick="clearSelection()">Cancel</button></div>
    <script>
        function showToast(m) { alert(m); }
        function searchUsers() { const t = document.getElementById('searchInput').value; if(t) window.location.href = '/admin/users?search='+encodeURIComponent(t); }
        const selectAll = document.getElementById('selectAllCheckbox'), checkboxes = document.querySelectorAll('.item-checkbox'), bulkBar = document.getElementById('bulkActionsBar'), countSpan = document.getElementById('selectedCount');
        function updateBulkBar() { const c = document.querySelectorAll('.item-checkbox:checked'); if(c.length) { bulkBar.classList.add('show'); countSpan.textContent = c.length; } else { bulkBar.classList.remove('show'); } }
        selectAll?.addEventListener('change', (e) => { checkboxes.forEach(cb => cb.checked = e.target.checked); updateBulkBar(); });
        checkboxes.forEach(cb => cb.addEventListener('change', updateBulkBar));
        function clearSelection() { checkboxes.forEach(cb => cb.checked = false); selectAll.checked = false; updateBulkBar(); }
        async function bulkDelete() { const ids = Array.from(document.querySelectorAll('.item-checkbox:checked')).map(cb=>cb.value); if(!ids.length) return; if(!confirm(`Delete ${ids.length} users?`)) return; alert('Delete functionality ready'); }
    </script>
</body>
</html>