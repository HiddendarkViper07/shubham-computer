<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Shubham Computer</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded" rel="stylesheet" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Poppins', sans-serif; }
        body { min-height: 100vh; display: flex; justify-content: center; align-items: center; background: radial-gradient(circle at top, #0f2027, #000000); color: #fff; padding: 20px; }
        .login-container { max-width: 420px; width: 100%; }
        .logo-wrapper { display: flex; flex-direction: column; align-items: center; margin-bottom: 30px; }
        .logo { width: 90px; height: 90px; object-fit: contain; margin-bottom: 10px; filter: drop-shadow(0 0 10px #00c3ff88); }
        .brand-name { font-size: 24px; font-weight: 600; }
        .brand-tag { font-size: 12px; color: #aaa; }
        .heading { font-size: 22px; margin-bottom: 25px; color: #ddd; text-align: center; }
        .alert { padding: 12px; border-radius: 12px; margin-bottom: 20px; }
        .alert-success { background: rgba(46, 204, 113, 0.2); border: 1px solid #2ecc71; color: #2ecc71; }
        .alert-error { background: rgba(255, 77, 77, 0.2); border: 1px solid #ff4d4d; color: #ff4d4d; }
        .input-box { display: flex; align-items: center; background: rgba(255,255,255,0.05); border-radius: 14px; padding: 14px 16px; margin-bottom: 16px; border: 1px solid rgba(255,255,255,0.05); transition: 0.3s; }
        .input-box:focus-within { border-color: #00c3ff; box-shadow: 0 0 10px #00c3ff55; }
        .input-box span { margin-right: 12px; font-size: 20px; }
        .input-box input { border: none; outline: none; width: 100%; color: #fff; background: transparent; font-size: 15px; }
        .input-box input::placeholder { color: #888; }
        .forgot { text-align: right; margin-bottom: 20px; }
        .forgot a { color: #00c3ff; text-decoration: none; font-size: 13px; }
        .btn { width: 100%; padding: 14px; border: none; border-radius: 14px; background: linear-gradient(135deg, #00c3ff, #3a7bd5); color: #fff; font-size: 16px; font-weight: 600; cursor: pointer; transition: 0.3s; }
        .btn:hover { transform: translateY(-2px); box-shadow: 0 5px 20px #00c3ff66; }
        .divider { display: flex; align-items: center; text-align: center; margin: 25px 0; color: #aaa; }
        .divider::before, .divider::after { content: ''; flex: 1; border-bottom: 1px solid rgba(255,255,255,0.1); }
        .divider span { padding: 0 15px; font-size: 12px; }
        .social-buttons { display: flex; flex-direction: column; gap: 12px; }
        .social-btn { display: flex; align-items: center; justify-content: center; gap: 12px; padding: 12px; border-radius: 14px; border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.03); color: #fff; font-size: 14px; font-weight: 500; cursor: pointer; text-decoration: none; transition: 0.3s; }
        .social-btn:hover { background: rgba(255,255,255,0.1); transform: translateY(-2px); }
        .social-btn img { width: 20px; height: 20px; }
        .social-btn.google:hover { border-color: #DB4437; }
        .social-btn.facebook:hover { border-color: #4267B2; }
        .social-btn.apple:hover { border-color: #000; }
        .signup-link { text-align: center; margin-top: 25px; font-size: 14px; color: #aaa; }
        .signup-link a { color: #00c3ff; text-decoration: none; font-weight: 500; }
        .admin-link { text-align: center; margin-top: 20px; }
        .admin-link a { color: #666; text-decoration: none; font-size: 12px; }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="logo-wrapper">
            <img src="/images/logo.png" class="logo" alt="logo" onerror="this.src='https://via.placeholder.com/90/00c3ff/ffffff?text=SC'">
            <div class="brand-name">Shubham Computers</div>
            <div class="brand-tag">Your Digital Service Partner</div>
        </div>
        <div class="heading">Welcome Back 👋</div>
        <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
        <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
        <form action="/auth/login" method="POST">
            <div class="input-box"><span>📧</span><input type="email" name="email" placeholder="Email Address" required></div>
            <div class="input-box"><span>🔒</span><input type="password" name="password" placeholder="Password" required></div>
            <div class="forgot"><a href="#">Forgot Password?</a></div>
            <button type="submit" class="btn">Login</button>
        </form>
        <% if (GOOGLE_CLIENT_ID || FACEBOOK_APP_ID || APPLE_CLIENT_ID) { %>
        <div class="divider"><span>OR CONTINUE WITH</span></div>
        <div class="social-buttons">
            <% if (GOOGLE_CLIENT_ID) { %><a href="/auth/google" class="social-btn google"><img src="https://cdn-icons-png.flaticon.com/512/300/300221.png" alt="Google">Continue with Google</a><% } %>
            <% if (FACEBOOK_APP_ID) { %><a href="/auth/facebook" class="social-btn facebook"><img src="https://cdn-icons-png.flaticon.com/512/733/733547.png" alt="Facebook">Continue with Facebook</a><% } %>
            <% if (APPLE_CLIENT_ID) { %><a href="/auth/apple" class="social-btn apple"><img src="https://cdn-icons-png.flaticon.com/512/0/747.png" alt="Apple">Continue with Apple</a><% } %>
        </div>
        <% } %>
        <div class="signup-link">Don't have an account? <a href="/signup">Sign Up</a></div>
        <div class="admin-link"><a href="/auth/admin-login">🔐 Admin Login</a></div>
    </div>
</body>
</html>